<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>APIBaseURL</key>
	<string>$(API_BASE_URL)</string>
	<key>CFBundleDisplayName</key>
	<string>ConvoLab</string>
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.cdcg.convolab.calendar-oauth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>convolab</string>
			</array>
		</dict>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSCameraUsageDescription</key>
	<string>ConvoLab uses the camera so you can add your own photos to study cards.</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>ConvoLab can add completed or planned study sessions to your calendar, including synced Google calendars.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>ConvoLab uses your photo library so you can add images to study cards.</string>
	<key>UIUserInterfaceStyle</key>
	<string>Light</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
